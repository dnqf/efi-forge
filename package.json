{
  "name": "efi-forge",
  "private": true,
  "version": "0.1.15",
  "homepage": "https://github.com/dnqf/efi-forge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dnqf/efi-forge.git"
  },
  "type": "module",
  "scripts": {
    "workspace:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/invoke-dev-workspace.ps1 -Task check",
    "workspace:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/invoke-dev-workspace.ps1 -Task full",
    "workspace:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/invoke-dev-workspace.ps1 -Task desktop-build",
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build --configLoader runner",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --bundles nsis",
    "desktop:check": "tauri build --no-bundle",
    "start:app": "node scripts/serve.mjs",
    "test": "vitest run --configLoader runner",
    "test:catalog": "node --test scripts/import-daliansky-catalog.test.mjs",
    "check:version": "node scripts/verify-version-sync.mjs",
    "check": "npm run check:version && npm test && npm run test:catalog && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.3",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "npm@10.9.7"
}
